    {
        "id": "sl_agg",
        "type": "function",
        "z": "sl_tab",
        "name": "State + event log",
        "func": "const initial = {source:'WAIT', door:'UNKNOWN', lock:'UNKNOWN', motion:false, mode:'NORMAL', alarm:false, reason:'', buzzer:false, relay:false, failedRFID:0, failedPIN:0, lastAccess:'—', count:0, updatedAt:'', events:[]};\nlet s=flow.get('smartlab_state') || initial;\nconst p=(typeof msg.payload==='string') ? (()=>{try{return JSON.parse(msg.payload)}catch(e){return null}})() : msg.payload;\nif (!p || typeof p!=='object') return null;\nif (msg.topic==='smartlab/security/telemetry') {\n const allowed=['door','lock','motion','mode','alarm','reason','buzzer','relay','failedRFID','failedPIN','lastAccess'];\n for(const k of allowed) if(Object.prototype.hasOwnProperty.call(p,k))s[k]=p[k];\n s.source='MQTT';s.count=(s.count||0)+1;s.updatedAt=new Date().toLocaleTimeString('id-ID');\n} else if(msg.topic==='smartlab/security/event') {\n const ev={time:new Date().toLocaleTimeString('id-ID'),type:String(p.type||'EVENT').slice(0,40),detail:String(p.detail||'').slice(0,200)};\n s.events=[ev,...(s.events||[])].slice(0,30);s.source='MQTT';s.updatedAt=ev.time;\n} else if(msg.topic==='DEMO') {\n s={...s,...p,source:'DEMO',count:(s.count||0)+1,updatedAt:new Date().toLocaleTimeString('id-ID')};\n if(p.demoEvent)s.events=[{time:s.updatedAt,type:p.demoEvent,detail:'Simulasi dashboard (bukan perangkat nyata)'},...(s.events||[])].slice(0,30);\n} else {return null}\nflow.set('smartlab_state',s);\nreturn {payload:{kind:'state',state:s}};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
