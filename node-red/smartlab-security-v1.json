[
    {
        "id": "sl_tab",
        "type": "tab",
        "label": "Smart Lab Security - Dashboard",
        "disabled": false,
        "info": "Dashboard 2.0 + MQTT + demo. Demo inject disabled by default after testing."
    },
    {
        "id": "sl_ui",
        "type": "ui-template",
        "z": "sl_tab",
        "group": "sl_group",
        "page": "",
        "ui": "",
        "name": "Smart Lab Security Panel",
        "order": 1,
        "width": "12",
        "height": "16",
        "head": "",
        "format": "<template>\n<div class=\"sl-shell\">\n <div class=\"sl-header\"><div><span class=\"sl-mark\">◈</span> SMART LAB <b>SECURITY CENTER</b><small> ESP32-S3 • ACCESS & INTRUSION MONITORING</small></div><span :class=\"['sl-pill',live?'sl-green':'sl-amber']\">{{ live ? '● LIVE MQTT' : (state.source==='DEMO' ? '● DEMO MODE' : '○ WAITING FOR DATA') }}</span></div>\n <div class=\"sl-layout\">\n  <aside class=\"sl-side\">\n   <h3>SYSTEM STATUS</h3>\n   <div class=\"sl-line\"><span>Communication</span><strong :class=\"live?'ok':'warn'\">{{live?'ONLINE':'OFFLINE'}}</strong></div>\n   <div class=\"sl-line\"><span>Access mode</span><strong>{{state.mode}}</strong></div>\n   <div class=\"sl-line\"><span>Alarm</span><strong :class=\"state.alarm?'bad':'ok'\">{{state.alarm?'ACTIVE':'NORMAL'}}</strong></div>\n   <div class=\"sl-line\"><span>Buzzer</span><strong>{{state.buzzer?'ON':'OFF'}}</strong></div>\n   <h3>OPERATIONS</h3>\n   <button @click=\"sendCommand('NORMAL')\">NORMAL MODE</button>\n   <button @click=\"sendCommand('AFTERHOURS')\">AFTERHOURS MODE</button>\n   <button class=\"amber\" @click=\"sendCommand('SILENCE')\">SILENCE BUZZER</button>\n   <p class=\"sl-notice\">Kontrol ini mengirim perintah MQTT. Perangkat hanya berubah jika firmware menerima perintahnya. Tidak ada remote UNLOCK.</p>\n  </aside>\n  <main class=\"sl-main\">\n   <section class=\"sl-cards\">\n    <div class=\"sl-card\"><span>DOOR SENSOR</span><strong :class=\"state.door==='OPEN'?'bad':'ok'\">{{state.door}}</strong><small>Push button GPIO 21</small></div>\n    <div class=\"sl-card\"><span>LOCK STATUS</span><strong :class=\"state.lock==='UNLOCKED'?'warn':'ok'\">{{state.lock}}</strong><small>Servo GPIO 40</small></div>\n    <div class=\"sl-card\"><span>PIR MOTION</span><strong :class=\"state.motion?'warn':'ok'\">{{state.motion?'DETECTED':'CLEAR'}}</strong><small>GPIO 38</small></div>\n    <div class=\"sl-card\"><span>SECURITY ALARM</span><strong :class=\"state.alarm?'bad':'ok'\">{{state.alarm?'TRIGGERED':'SECURE'}}</strong><small>{{state.reason||'No alarm'}}</small></div>\n   </section>\n   <section class=\"sl-cards sl-bottom\">\n    <div class=\"sl-card\"><span>ACCESS METHOD</span><strong>{{state.lastAccess || '—'}}</strong><small>RFID or Keypad</small></div>\n    <div class=\"sl-card\"><span>FAILED RFID</span><strong>{{state.failedRFID ?? 0}} <em>/3</em></strong></div>\n    <div class=\"sl-card\"><span>FAILED PIN</span><strong>{{state.failedPIN ?? 0}} <em>/3</em></strong></div>\n    <div class=\"sl-card\"><span>RELAY / BUZZER</span><strong>{{state.relay?'ON':'OFF'}} / {{state.buzzer?'ON':'OFF'}}</strong><small>Alarm outputs</small></div>\n   </section>\n   <section class=\"sl-panel\"><div class=\"sl-heading\">EVENTS & ALERTS <span>Last update: {{timeLabel}}</span></div>\n    <div class=\"sl-events\"><div v-if=\"!state.events || !state.events.length\" class=\"sl-empty\">Belum ada kejadian yang diterima.</div><div v-for=\"(ev,i) in (state.events||[]).slice(0,12)\" :key=\"i\" class=\"sl-event\"><time>{{ev.time||'--:--:--'}}</time><b :class=\"/ALARM|DENIED|FORCED/.test(ev.type)?'bad':'ok'\">{{ev.type}}</b><span>{{ev.detail}}</span></div></div>\n   </section>\n   <div class=\"sl-footer\">Telemetry topic: smartlab/security/telemetry • Events: smartlab/security/event • Commands: smartlab/security/cmd <span>RECEIVED: {{state.count||0}}</span></div>\n  </main>\n </div>\n</div>\n</template>\n<script>\nexport default {\n data(){return {state:{source:'WAIT',door:'UNKNOWN',lock:'UNKNOWN',motion:false,mode:'NORMAL',alarm:false,buzzer:false,relay:false,failedRFID:0,failedPIN:0,lastAccess:'—',reason:'',events:[],count:0,updatedAt:''}, lastReceived:0, tick:0, intervalId:null}},\n computed:{live(){return this.state.source==='MQTT' && (this.tick-this.lastReceived)<10000}, timeLabel(){return this.state.updatedAt||'—'}},\n watch:{msg:{handler(v){if(v && v.payload && typeof v.payload==='object' && v.payload.kind==='state'){this.state=v.payload.state; if(this.state.source==='MQTT')this.lastReceived=Date.now();}},deep:true}},\n mounted(){this.tick=Date.now();this.intervalId=setInterval(()=>{this.tick=Date.now()},1000)},\n unmounted(){if(this.intervalId)clearInterval(this.intervalId)},\n methods:{sendCommand(cmd){this.send({topic:'dashboard-command',payload:cmd})}}\n}\n</script>\n<style>\n.sl-shell{color:#eef6fa;background:#161b20;font-family:Arial,system-ui,sans-serif;border-radius:8px;overflow:hidden;min-height:620px}.sl-header{height:auto;min-height:56px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#008b8f;padding:13px 20px;font-size:15px;font-weight:600;flex-wrap:wrap}.sl-header small{font-size:10px;opacity:.82;font-weight:400;margin-left:8px}.sl-mark{font-size:24px;vertical-align:middle}.sl-pill{padding:7px 12px;border-radius:99px;font-size:11px;background:#193b3d}.sl-green{color:#66f2b4}.sl-amber{color:#f8d179}.sl-layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:8px;padding:9px}.sl-side{background:#22272d;padding:12px;border-radius:5px;min-width:0}.sl-side h3{font-size:12px;border-bottom:1px solid #39414a;margin:5px 0 12px;padding-bottom:10px}.sl-side h3:not(:first-child){margin-top:25px}.sl-line{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-bottom:1px solid #333b42;font-size:12px}.sl-line strong{font-size:12px}.sl-side button{width:100%;padding:12px 7px;margin-bottom:10px;background:#1365a9;color:white;border:0;border-radius:4px;font-weight:700;cursor:pointer}.sl-side button:nth-of-type(2){background:#067c4e}.sl-side button.amber{background:#a45114}.sl-notice{color:#9daeb8;font-size:11px;line-height:1.5}.sl-main{min-width:0}.sl-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.sl-bottom{margin-top:8px}.sl-card{background:#242a30;border-left:4px solid #17afc3;min-height:112px;padding:16px 14px;display:flex;flex-direction:column;gap:10px;min-width:0}.sl-card span{font-size:11px;font-weight:700;color:#c5d6dc;letter-spacing:.5px}.sl-card strong{font-size:20px;word-wrap:break-word}.sl-card em{font-style:normal;font-size:13px;color:#8396a2}.sl-card small{font-size:11px;color:#a0b0b8;overflow-wrap:anywhere}.ok{color:#60e4a0!important}.bad{color:#ff7979!important}.warn{color:#ffcc74!important}.sl-panel{background:#242a30;margin-top:8px;min-height:220px}.sl-heading{border-bottom:1px solid #3a424a;background:#1e2328;font-size:12px;font-weight:700;padding:13px;display:flex;justify-content:space-between}.sl-heading span{font-weight:400;color:#91a7b1}.sl-events{padding:8px 12px;max-height:290px;overflow-y:auto}.sl-event{display:grid;grid-template-columns:85px 150px minmax(0,1fr);gap:12px;padding:9px 3px;border-bottom:1px solid #343c43;font-size:12px;align-items:start}.sl-event time{color:#a1b1bd}.sl-event span{overflow-wrap:anywhere}.sl-empty{color:#8fa1ac;padding:20px 5px;font-size:13px}.sl-footer{display:flex;gap:10px;justify-content:space-between;padding:12px;color:#9bb1be;font-size:10px;flex-wrap:wrap}@media(max-width:950px){.sl-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.sl-layout{grid-template-columns:1fr}.sl-cards{grid-template-columns:1fr 1fr}.sl-header small{display:block}.sl-event{grid-template-columns:65px 95px minmax(0,1fr);gap:6px;font-size:10px}.sl-card strong{font-size:16px}}\n</style>",
        "storeOutMessages": true,
