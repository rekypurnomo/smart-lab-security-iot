    {
        "id": "sl_cmd",
        "type": "function",
        "z": "sl_tab",
        "name": "Safe dashboard commands",
        "func": "const c=String(msg.payload||'').toUpperCase().trim();\n// Hanya kendali non-kritis; tanpa UNLOCK/RESET lewat dashboard.\nif (!['NORMAL','AFTERHOURS','SILENCE'].includes(c))return null;\nreturn {topic:'smartlab/security/cmd',payload:c,qos:'0',retain:'false'};",
