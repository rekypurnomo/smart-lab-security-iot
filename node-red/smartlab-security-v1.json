    {
        "id": "sl_demo",
        "type": "function",
        "z": "sl_tab",
        "name": "Demo sequence (manual)",
        "func": "let n=(context.get('n')||0)+1;context.set('n',n);\nlet scene=n%6;\nconst base={door:'CLOSED',lock:'LOCKED',motion:false,mode:'NORMAL',alarm:false,reason:'',buzzer:false,relay:false,failedRFID:0,failedPIN:0,lastAccess:'—'};\nif(scene===1){base.lock='UNLOCKED';base.lastAccess='RFID';base.demoEvent='ACCESS_GRANTED'}\nif(scene===2){base.door='OPEN';base.lock='UNLOCKED';base.lastAccess='RFID';base.demoEvent='DOOR_OPEN'}\nif(scene===3){base.door='CLOSED';base.lock='LOCKED';base.demoEvent='DOOR_CLOSED'}\nif(scene===4){base.failedPIN=2;base.demoEvent='PIN_DENIED'}\nif(scene===5){base.alarm=true;base.failedPIN=3;base.reason='PIN_SALAH_3_KALI';base.buzzer=true;base.relay=true;base.demoEvent='ALARM_TRIGGERED'}\nif(scene===0){base.demoEvent='ALARM_RESET'}\nreturn {topic:'DEMO',payload:base};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 280,
        "wires": [
            [
                "sl_agg"
            ]
        ]
    },
