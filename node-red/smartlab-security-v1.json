    {
        "id": "a7fc13a0ee777d53",
        "type": "function",
        "z": "sl_tab",
        "name": "Security Simulation Engine",
        "func": "\nconst command = String(msg.payload)\n    .trim()\n    .toUpperCase();\n\nlet state = flow.get(\"smartlab_sim_state\") || {\n    door: \"CLOSED\",\n    lock: \"LOCKED\",\n    pir: \"CLEAR\",\n    alarm: false,\n    buzzer: false,\n    relay: false,\n    mode: \"NORMAL\",\n    rfid_failed: 0,\n    pin_failed: 0\n};\n\nswitch (command) {\n    case \"AFTERHOURS\":\n        state.mode = \"AFTERHOURS\";\n        break;\n\n    case \"NORMAL\":\n        state.mode = \"NORMAL\";\n        break;\n\n    case \"SILENCE\":\n        state.buzzer = false;\n        break;\n\n    default:\n        node.warn(\"Unknown command: \" + command);\n        return null;\n}\n\nflow.set(\"smartlab_sim_state\", state);\n\nmsg.topic = \"smartlab/security/telemetry\";\nmsg.payload = JSON.stringify(state);\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: state.mode\n});\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
